// PHASE 2 — deploy only once FEATURE_FLAGS.SHARE_ENABLED is turned on.
// Deploy with: firebase deploy --only firestore:rules
//
// Core idea: a trip/party is only readable/writable by uids listed in its
// own memberIds array. Nobody can hard-delete from the client — that's
// reserved for the scheduled purgeTrash Cloud Function, so a soft-deleted
// item can't be bypassed by a malicious client calling delete() directly.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /trips/{tripId} {
      allow read, update: if isMember(resource.data.memberIds);
      allow create: if request.auth != null
                    && isMember(request.resource.data.memberIds)
                    && request.resource.data.ownerId == request.auth.uid;
      allow delete: if false;
    }

    match /parties/{partyId} {
      allow read, update: if isMember(resource.data.memberIds);
      allow create: if request.auth != null
                    && isMember(request.resource.data.memberIds)
                    && request.resource.data.ownerId == request.auth.uid;
      allow delete: if false;
    }

    function isMember(memberIds) {
      return request.auth != null && request.auth.uid in memberIds;
    }
  }
}
